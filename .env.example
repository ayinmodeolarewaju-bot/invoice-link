# 1 = simulate the whole 1-Click flow locally (default). 0 = call the live 1-Click API (mainnet assets, real funds!)
MOCK_1CLICK=1
# Optional partner JWT from https://partners.near-intents.org (without it, live quotes carry +0.25% fee)
ONECLICK_JWT=
# NEAR network for the wallet selector: testnet | mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
